<!doctype html>
{# Orbit weekly report. Rendered by orbit/report.py; everything inline so the
   file works offline and by email. All values are autoescaped. #}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Orbit report{% if run %} – {{ run.date }}{% endif %}</title>
<style>
  :root {
    --bg: #f7f7f5; --panel: #ffffff; --text: #1d1d1b; --muted: #6b6b66;
    --line: #e2e1dc; --accent: #2457c5; --ok: #1e7a3c; --warn: #9a5b00;
    --bad: #b3261e; --blocked: #5b5b5b; --review-bg: #fff5df; --banner-bg: #3b2a8f;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161615; --panel: #1f1f1d; --text: #ecebe6; --muted: #a3a29b;
      --line: #34332f; --accent: #8fb0ff; --ok: #6fcf8e; --warn: #f2b45a;
      --bad: #ff8a80; --blocked: #b0b0ab; --review-bg: #3a2f14; --banner-bg: #4b3bb0;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 48px; }
  .banner { background: var(--banner-bg); color: #fff; text-align: center;
            padding: 10px 16px; font-weight: 600; letter-spacing: .02em; }
  h1 { margin: 0 0 4px; font-size: 1.6rem; }
  h2 { margin: 0 0 12px; font-size: 1.2rem; }
  h3 { margin: 20px 0 8px; font-size: 1rem; }
  section { background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
            padding: 20px; margin-top: 20px; }
  .muted { color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; padding: 0; list-style: none; }
  .chips li { border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line);
           vertical-align: top; }
  th { font-size: .85rem; color: var(--muted); font-weight: 600; }
  .table-wrap { overflow-x: auto; }
  .tag { display: inline-block; border-radius: 4px; padding: 1px 8px; font-size: .8rem;
         font-weight: 600; white-space: nowrap; border: 1px solid currentColor; }
  .tag.MOVED, .tag.JOINED { color: var(--accent); }
  .tag.LEFT { color: var(--bad); }
  .tag.OFFICE_CHANGED, .tag.TITLE_CHANGED { color: var(--muted); }
  .tag.REVIEW, .tag.SUSPECT { color: var(--warn); }
  .tag.OK { color: var(--ok); }
  .tag.FAILED { color: var(--bad); }
  .tag.BLOCKED, .tag.SKIPPED, .tag.OUT-OF-SCOPE, .tag.NOT-ASSESSED { color: var(--blocked); }
  .review { background: var(--review-bg); border-radius: 8px; padding: 12px 16px; margin-top: 16px; }
  .review p { margin: 0 0 8px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .filters input, .filters select { font: inherit; padding: 6px 8px; border-radius: 6px;
           border: 1px solid var(--line); background: var(--bg); color: var(--text); }
  .filters input { flex: 1 1 220px; }
  a { color: var(--accent); }
  .empty { color: var(--muted); font-style: italic; }
  .stale-note { color: var(--warn); font-size: .9rem; }
  p.stale-note { background: var(--review-bg); border-radius: 6px; padding: 8px 12px; margin: 0 0 12px; }
</style>
</head>
<body>
{% if banner %}<div class="banner" role="note">{{ banner }}</div>{% endif %}
<main>
<header>
  <h1>Orbit: partner market report</h1>
  {% if run %}
  <p class="muted">Run {{ run.id }} · {{ run.date }} · {{ firms | length }} firm{{ "s" if firms | length != 1 }} tracked · generated {{ generated_at }}</p>
  <ul class="chips" aria-label="Partners per firm">
    {% for firm in firms %}
    <li>{{ firm.name }}: <strong>{{ firm.count }}</strong> partners{% if firm.status != "OK" %} <span class="tag {{ firm.status }}">{{ firm.status }}</span>{% endif %}{% if firm.note %} <span class="stale-note">{{ firm.note }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">No runs yet. Run <code>orbit run</code> to collect the first snapshot.</p>
  {% endif %}
</header>

{% if run %}
<section aria-labelledby="changes-heading">
  <h2 id="changes-heading">This week's changes</h2>
  {% for firm in baseline %}
  <p class="muted">{{ firm }}: baseline recorded, changes appear from the next run.</p>
  {% endfor %}
  {% if changes %}
  <div class="table-wrap">
  <table>
    <thead><tr><th>Change</th><th>Partner</th><th>Firm</th><th>Details</th></tr></thead>
    <tbody>
    {% for change in changes %}
      <tr>
        <td><span class="tag {{ change.type }}">{{ change.label }}</span></td>
        <td>{% if change.link %}<a href="{{ change.link }}" rel="noopener">{{ change.name }}</a>{% else %}{{ change.name }}{% endif %}</td>
        <td>{{ change.where }}</td>
        <td>{{ change.detail or "" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% elif not baseline %}
  <p class="empty">No changes since the last run.</p>
  {% endif %}

  {% if review %}
  <div class="review">
    <h3>Needs review <span class="muted">({{ review | length }})</span></h3>
    <p class="muted">Possible matches the system won't assert on its own. Check them before using them.</p>
    {% for item in review %}
    <p><span class="tag REVIEW">Needs review: {{ item.label }}</span>
       <strong>{% if item.link %}<a href="{{ item.link }}" rel="noopener">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}</strong>,
       {{ item.where }}. {{ item.detail }}</p>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

<section aria-labelledby="health-heading">
  <h2 id="health-heading">Firm health</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Firm</th><th>Status</th><th>Partners</th><th>Reason</th></tr></thead>
    <tbody>
    {% for row in health %}
      <tr>
        <td>{{ row.name }}</td>
        <td><span class="tag {{ row.status | replace(' ', '-') }}">{{ row.status }}</span></td>
        <td>{{ row.count if row.count is not none else "—" }}</td>
        <td>{{ row.reason }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

{% if run %}
<section aria-labelledby="partners-heading">
  <h2 id="partners-heading">All partners <span class="muted" id="partner-count">({{ partners | length }})</span></h2>
  {% for item in stale %}
  <p class="stale-note" role="note"><strong>{{ item.name }}:</strong> {{ item.note }}.</p>
  {% endfor %}
  <div class="filters">
    <input id="search" type="search" placeholder="Search name or title" aria-label="Search partners">
    <select id="firm-filter" aria-label="Filter by firm"><option value="">All firms</option>{% for v in filters.firms %}<option>{{ v }}</option>{% endfor %}</select>
    <select id="office-filter" aria-label="Filter by office"><option value="">All offices</option>{% for v in filters.offices %}<option>{{ v }}</option>{% endfor %}</select>
    <select id="practice-filter" aria-label="Filter by practice"><option value="">All practices</option>{% for v in filters.practices %}<option>{{ v }}</option>{% endfor %}</select>
  </div>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Firm</th><th>Title</th><th>Offices</th><th>Practices</th></tr></thead>
    <tbody id="partner-rows">
    {% for p in partners %}
      <tr data-firm="{{ p.firm }}" data-offices="|{{ p.offices | join('|') }}|" data-practices="|{{ p.practices | join('|') }}|">
        <td><a href="{{ p.url }}" rel="noopener">{{ p.name }}</a></td>
        <td>{{ p.firm }}</td>
        <td>{{ p.title }}</td>
        <td>{{ p.offices | join(", ") }}</td>
        <td>{{ p.practices | join(", ") }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p id="no-matches" class="empty" hidden>No partners match these filters.</p>
</section>
{% endif %}
</main>

{% if run %}
<script>
  // Filters the partner table in place: text search plus three drop-downs.
  (function () {
    var rows = Array.prototype.slice.call(document.querySelectorAll("#partner-rows tr"));
    var search = document.getElementById("search");
    var firm = document.getElementById("firm-filter");
    var office = document.getElementById("office-filter");
    var practice = document.getElementById("practice-filter");
    function apply() {
      var text = search.value.trim().toLowerCase();
      var shown = 0;
      rows.forEach(function (row) {
        var visible = (!text || row.textContent.toLowerCase().indexOf(text) !== -1)
          && (!firm.value || row.dataset.firm === firm.value)
          && (!office.value || row.dataset.offices.indexOf("|" + office.value + "|") !== -1)
          && (!practice.value || row.dataset.practices.indexOf("|" + practice.value + "|") !== -1);
        row.hidden = !visible;
        if (visible) { shown += 1; }
      });
      document.getElementById("partner-count").textContent = "(" + shown + " of " + rows.length + ")";
      document.getElementById("no-matches").hidden = shown !== 0;
    }
    [search, firm, office, practice].forEach(function (el) { el.addEventListener("input", apply); });
  })();
</script>
{% endif %}
</body>
</html>
